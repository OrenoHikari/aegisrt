[Unit]
Description=CAPSuleRT descendant fault-domain cleanup test
After=local-fs.target

[Service]
Type=oneshot

User=linya
Group=linya

WorkingDirectory=/home/linya/workspace/aegisrt

ExecStart=/usr/local/libexec/aegisrt/aegisd -worker /home/linya/workspace/aegisrt/worker/python/descendant_agent.py -agent-seconds=30 -timeout=2s -cpu-percent=100 -memory-mib=128 -pids-max=16

Delegate=cpu memory pids

CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes

TimeoutStartSec=15

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
