[Unit]
Description=AegisRT integrated Agent resource demo
After=local-fs.target

[Service]
Type=oneshot

User=linya
Group=linya

WorkingDirectory=/home/linya/workspace/aegisrt

ExecStart=/usr/local/libexec/aegisrt/aegisd -worker /home/linya/workspace/aegisrt/worker/python/hello_agent.py -agent-seconds=8 -timeout=15s -cpu-percent=25 -memory-mib=128 -pids-max=16

Delegate=cpu memory pids

CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes

TimeoutStartSec=30

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
